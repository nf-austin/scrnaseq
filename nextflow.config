manifest {
    name            = 'nf-austin/scrnaseq'
    author          = 'Austin Varela'
    homePage        = 'https://github.com/nf-austin/scrnaseq'
    description     = 'End-to-end 10x scRNA-seq pipeline: Cell Ranger (count or multi/Flex) + species-aware scanpy QC.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
    defaultBranch   = 'main'
}

params {
    // Input/Output
    fastq_dirs         = "data/*"
    multi_configs      = "configs/*.csv"
    outdir             = "results"

    // Biology & Chemistry
    species            = 'human' // 'human' or 'mouse'
    flex_version       = 'v1'    // 'v1' or 'v2' (APEX)
    expect_cells       = 10000

    // Mode toggles
    run_flex           = false
    run_scrublet       = true
    create_bam         = true   // Cell Ranger >=8 requires explicit --create-bam

    // References (Auto-resolved in main.nf based on species/flex_version if left null)
    transcriptome      = null
    transcriptome_url  = null

    probe_set          = null
    probe_set_url      = null

    // Resource caps (applied via process.resourceLimits below). Use Nextflow
    // unit literals (.GB, .h) so values stay typed as MemoryUnit / Duration.
    max_memory         = 128.GB
    max_cpus           = 32
    max_time           = 72.h
}

process {
    // Nextflow 24.04+ enforces these caps automatically on every task,
    // superseding the old hand-rolled check_max() helper.
    resourceLimits = [
        memory: params.max_memory,
        cpus  : params.max_cpus,
        time  : params.max_time
    ]

    withName: 'DOWNLOAD_REFERENCE|DOWNLOAD_PROBE_SET' {
        cpus   = 2
        memory = '4.GB'
        time   = '2.h'
    }

    withName: 'CELLRANGER_COUNT|CELLRANGER_MULTI' {
        cpus          = { 16    * task.attempt }
        memory        = { 64.GB * task.attempt }
        time          = { 24.h  * task.attempt }
        errorStrategy = 'retry'
        maxRetries    = 2
    }

    withName: 'SCANPY_QC' {
        cpus   = 4
        memory = '16.GB'
        time   = '2.h'
    }
}

profiles {
    docker {
        docker.enabled        = true
        docker.userEmulation  = true
        conda.enabled         = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = true
    }
    conda {
        conda.enabled = true
    }
}