manifest {
    name            = 'nf-austin/scrnaseq'
    author          = 'Austin Varela'
    homePage        = 'https://github.com/nf-austin/scrnaseq'
    description     = 'End-to-end 10x scRNA-seq pipeline: Cell Ranger (count or multi/Flex) + species-aware scanpy QC.'
    mainScript      = 'main.nf'
    nextflowVersion = '>=23.04.0'
    version         = '1.0.0'
    defaultBranch   = 'main'
}

params {
    // Input/Output
    fastq_dirs         = "data/*"
    multi_configs      = "configs/*.csv"
    outdir             = "results"

    // Biology & Chemistry
    species            = 'human' // 'human' or 'mouse'
    flex_version       = 'v1'    // 'v1' or 'v2' (APEX)
    expect_cells       = 10000

    // Mode toggles
    run_flex           = false
    run_scrublet       = true

    // References (Auto-resolved in main.nf based on species/flex_version if left null)
    transcriptome      = null
    transcriptome_url  = null

    probe_set          = null
    probe_set_url      = null

    // Resource allocation defaults
    max_memory         = '128.GB'
    max_cpus           = 32
    max_time           = '72.h'
}

process {
    withName: 'DOWNLOAD_REFERENCE|DOWNLOAD_PROBE_SET' {
        cpus   = 2
        memory = '4.GB'
        time   = '2.h'
    }

    withName: 'CELLRANGER_COUNT|CELLRANGER_MULTI' {
        cpus   = { check_max( 16 * task.attempt, 'cpus' ) }
        memory = { check_max( 64.GB * task.attempt, 'memory' ) }
        time   = { check_max( 24.h * task.attempt, 'time' ) }
        errorStrategy = 'retry'
        maxRetries = 2
    }

    withName: 'SCANPY_QC' {
        cpus   = 4
        memory = '16.GB'
        time   = '2.h'
    }
}

profiles {
    docker {
        docker.enabled        = true
        docker.userEmulation  = true
        conda.enabled         = true
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        conda.enabled          = true
    }
    conda {
        conda.enabled = true
    }
}

def check_max(obj, type) {
    if (type == 'memory') {
        try {
            if (obj.compareTo(params.max_memory as nextflow.util.MemoryUnit) == 1)
                return params.max_memory as nextflow.util.MemoryUnit
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            if (obj.compareTo(params.max_time as nextflow.util.Duration) == 1)
                return params.max_time as nextflow.util.Duration
            else
                return obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            return Math.min( obj, params.max_cpus as int )
        } catch (all) { return obj }
    }
}